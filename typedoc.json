{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/core",
    "src/life-engine",
    "src/scene/models",
    "src/scene/performance"
  ],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "plugin": ["typedoc-plugin-markdown"],
  "tsconfig": "tsconfig.typedoc.json",
  "excludePrivate": true,
  "excludeInternal": true,
  "readme": "none"
}
